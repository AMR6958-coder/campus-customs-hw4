# Copy this file to .env and fill in real values. .env is git-ignored.

# Secret used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-me-with-a-long-random-string

# LLM access for the shopping assistant. The course uses the Portkey gateway,
# which forwards OpenAI-compatible requests to OpenAI.
PORTKEY_API_KEY=replace-me-with-your-portkey-key
PORTKEY_BASE_URL=https://api.portkey.ai/v1
OPENAI_MODEL=gpt-5.6-luna

# Store owner: the account that receives inventory notes (reorder / do-not-reorder).
OWNER_EMAIL=test@campuscustoms.yale.edu

# Inventory rules (defaults shown). A size is "low" at or below 20% of par.
INVENTORY_PAR_LEVEL=25
INVENTORY_REORDER_THRESHOLD=0.20
INVENTORY_WINDOW_DAYS=30
INVENTORY_MIN_VIEWS=5
