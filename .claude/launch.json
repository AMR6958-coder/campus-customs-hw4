{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "main:app",
        "--reload",
        "--port", "8000",
        "--app-dir", "backend",
        "--reload-dir", "backend",
        "--reload-exclude", ".venv/*"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "frontend/node_modules/vite/bin/vite.js",
        "frontend",
        "--port", "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
